{
  "name": "german-b1-grammar",
  "private": true,
  "version": "1.5.4",
  "description": "Deutsch A0–B1 — тренажер німецької граматики та письма",
  "author": "OiGeNchecK",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.2.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.oigencheck.deutsch-b1",
    "productName": "Deutsch B1",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Deutsch-B1-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "artifactName": "Deutsch-B1-${version}-mac.${ext}"
    }
  }
}
